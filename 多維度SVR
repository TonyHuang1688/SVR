# svr_multioutput.py
# 範例：多輸出（multi-output）SVR：MultiOutputRegressor 與 RegressorChain 範例，
# 包含資料生成、前處理、GridSearchCV 超參數搜尋與評估。

import numpy as np
from sklearn.datasets import make_regression
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import StandardScaler
from sklearn.svm import SVR
from sklearn.multioutput import MultiOutputRegressor, RegressorChain
from sklearn.metrics import mean_squared_error, r2_score
import joblib

def make_data(n_samples=2000, n_features=10, n_targets=3, noise=0.1, random_state=42):
    # 產生多輸出回歸的合成資料
    X, Y = make_regression(n_samples=n_samples,
                           n_features=n_features,
                           n_targets=n_targets,
                           noise=noise,
                           random_state=random_state)
    return X, Y

def train_multioutput_svr(X_train, y_train):
    # Pipeline: 先 scale X，再用 MultiOutputRegressor 包裝 SVR
    pipe = Pipeline([
        ("scaler", StandardScaler()),
        ("mvr", MultiOutputRegressor(SVR()))
    ])

    param_grid = {
        # 注意 param name: 'mvr__estimator__...' 指向 MultiOutputRegressor 裡面的 base estimator (SVR)
        "mvr__estimator__kernel": ["rbf", "linear"],
        "mvr__estimator__C": [0.1, 1, 10],
        "mvr__estimator__epsilon": [0.01, 0.1],
        "mvr__estimator__gamma": ["scale"]  # 'gamma' 只對 rbf 有作用
    }

    grid = GridSearchCV(pipe, param_grid, cv=3, scoring="neg_mean_squared_error", n_jobs=-1, verbose=2)
    grid.fit(X_train, y_train)
    return grid

def train_regressor_chain(X_train, y_train):
    # RegressorChain：順序地建立多個 estimator，可建模目標間的依賴
    # 這裡我們把 chain 放在 pipeline 中（對 X 做標準化）
    chain_pipeline = Pipeline([
        ("scaler", StandardScaler()),
        ("chain", RegressorChain(SVR()))
    ])

    param_grid = {
        # base_estimator 的參數透過 'chain__base_estimator__...' 指定
        "chain__base_estimator__kernel": ["rbf", "linear"],
        "chain__base_estimator__C": [1, 10],
        "chain__base_estimator__epsilon": [0.01, 0.1]
    }

    grid = GridSearchCV(chain_pipeline, param_grid, cv=3, scoring="neg_mean_squared_error", n_jobs=-1, verbose=2)
    grid.fit(X_train, y_train)
    return grid

def evaluate(model, X_test, y_test):
    y_pred = model.predict(X_test)
    # per-target MSE (raw_values) 與平均 MSE
    mse_per_target = mean_squared_error(y_test, y_pred, multioutput='raw_values')
    mse_avg = mean_squared_error(y_test, y_pred, multioutput='uniform_average')
    r2_per_target = [r2_score(y_test[:, i], y_pred[:, i]) for i in range(y_test.shape[1])]
    return {"y_pred": y_pred, "mse_per_target": mse_per_target, "mse_avg": mse_avg, "r2_per_target": r2_per_target}

def main():
    X, Y = make_data(n_samples=2000, n_features=20, n_targets=3, noise=5.0)
    X_train, X_test, y_train, y_test = train_test_split(X, Y, test_size=0.2, random_state=42)

    print("Training MultiOutputRegressor-wrapped SVR (independent models)...")
    grid_mvr = train_multioutput_svr(X_train, y_train)
    print("Best params (MVR):", grid_mvr.best_params_)
    res_mvr = evaluate(grid_mvr.best_estimator_, X_test, y_test)
    print("MVR per-target MSE:", res_mvr["mse_per_target"])
    print("MVR avg MSE:", res_mvr["mse_avg"])
    print("MVR per-target R2:", res_mvr["r2_per_target"])

    # 儲存模型
    joblib.dump(grid_mvr.best_estimator_, "svr_multioutput_mvr.joblib")
    print("Saved MultiOutputRegressor model to svr_multioutput_mvr.joblib")

    print("\nTraining RegressorChain-wrapped SVR (chained models)...")
    grid_chain = train_regressor_chain(X_train, y_train)
    print("Best params (Chain):", grid_chain.best_params_)
    res_chain = evaluate(grid_chain.best_estimator_, X_test, y_test)
    print("Chain per-target MSE:", res_chain["mse_per_target"])
    print("Chain avg MSE:", res_chain["mse_avg"])
    print("Chain per-target R2:", res_chain["r2_per_target"])

    joblib.dump(grid_chain.best_estimator_, "svr_multioutput_chain.joblib")
    print("Saved RegressorChain model to svr_multioutput_chain.joblib")

if __name__ == "__main__":
    main()
